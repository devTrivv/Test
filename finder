--=== HELPERS DE ARQUIVO ===--
local function saveMode()
    writeF(CONFIG_FILE, tostring(currentModeIndex))
end

local function loadMode()
    local content = readF(CONFIG_FILE)
    if content then
        local num = tonumber(content)
        if num and num >= 1 and num <= #MODES then
            currentModeIndex = num
        end
    end
end

