local hasWriteFile = (typeof(writefile) == "function")
local hasReadFile = (typeof(readfile) == "function")
local hasDelFile = (typeof(delfile) == "function")

local function writeF(name, content)
    if not hasWriteFile then return false end
    local ok = pcall(function() writefile(name, content) end)
    return ok
end

local function readF(name)
    if not hasReadFile then return nil end
    local ok, content = pcall(function() return readfile(name) end)
    if ok and content and #content > 0 then return content end
    return nil
end

local function deleteF(name)
    if not hasDelFile then return end
    pcall(function() delfile(name) end)
end

local function markAuto()
    writeF(AUTO_FILE, tostring(tick()))
end

local function wasQueued()
    local content = readF(AUTO_FILE)
    deleteF(AUTO_FILE)
    if not content then return false end
    local savedTick = tonumber(content)
    if not savedTick then return false end
    local currentTick = tick()
    if currentTick < savedTick then return false end
    if (currentTick - savedTick) > 30 then return false end
    return true
end

