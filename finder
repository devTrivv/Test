    local mode = MODES[currentModeIndex]
    
    if mainFrameRef then
        local stroke = mainFrameRef:FindFirstChild("MainStroke")
        if stroke then stroke.Color = mode.stroke end
    end
    if headerRef then
        headerRef.BackgroundColor3 = mode.headerBg
        for _, child in ipairs(headerRef:GetChildren()) do
            if child.Name == "HeaderFix" then
                child.BackgroundColor3 = mode.headerBg
            end
        end
        local titleLbl = headerRef:FindFirstChild("Title")
        if titleLbl then titleLbl.TextColor3 = mode.accent end
        local accentBar = headerRef:FindFirstChild("AccentBar")
        if accentBar then accentBar.BackgroundColor3 = mode.accent end
