local function saveMode()
    writeF(CONFIG_FILE, tostring(currentModeIndex))
end

local function loadMode()
    local content = readF(CONFIG_FILE)
    if content then
        local num = tonumber(content)
        if num and num >= 1 and num <= #MODES then
            currentModeIndex = num
        end
    end
end

local function getCurrentEventName()
    return MODES[currentModeIndex].name
end

local function findEvent()
    return Workspace:FindFirstChild(getCurrentEventName())
end

local function setStatus(text, color)
    if not statusLabel then return end
    statusLabel.Text = text
    statusLabel.TextColor3 = color or Color3.fromRGB(150, 150, 155)
end

local function updateGuiStatus()
    if not currentGui then return end
    local b = currentGui:FindFirstChild("FinderButton", true)
    if not b then return end
    local mode = MODES[currentModeIndex]
    if not autoHopEnabled then
        b.Text, b.TextColor3, b.BackgroundColor3 = "SEARCH", Color3.fromRGB(180, 90, 90), Color3.fromRGB(35, 18, 18)
        if btnStrokeRef then btnStrokeRef.Color = mode.stroke end
    elseif findEvent() then
        b.Text, b.TextColor3, b.BackgroundColor3 = "FOUND!", FOUND_COLOR, FOUND_BG
        if btnStrokeRef then btnStrokeRef.Color = FOUND_COLOR end
    elseif isHopping then
        b.Text, b.TextColor3, b.BackgroundColor3 = "SEARCHING", mode.accent, mode.btnBg
        if btnStrokeRef then btnStrokeRef.Color = mode.stroke end
    else
        b.Text, b.TextColor3, b.BackgroundColor3 = "SEARCH", mode.accent, mode.btnBg
        if btnStrokeRef then btnStrokeRef.Color = mode.stroke end
    end
end

local function applyModeColors()
    if not currentGui then return end
    local mode = MODES[currentModeIndex]
    if mainFrameRef then
        local stroke = mainFrameRef:FindFirstChild("MainStroke")
        if stroke then stroke.Color = mode.stroke end
    end
    if headerRef then
        headerRef.BackgroundColor3 = mode.headerBg
        for _, child in ipairs(headerRef:GetChildren()) do
            if child.Name == "HeaderFix" then
                child.BackgroundColor3 = mode.headerBg
            end
        end
        local titleLbl = headerRef:FindFirstChild("Title")
        if titleLbl then titleLbl.TextColor3 = mode.accent end
        local accentBar = headerRef:FindFirstChild("AccentBar")
        if accentBar then accentBar.BackgroundColor3 = mode.accent end
    end
    if modeLabel then
        modeLabel.Text = mode.label
        modeLabel.TextColor3 = mode.accent
    end
    if modeFrameRef then
        local mStroke = modeFrameRef:FindFirstChild("ModeStroke")
        if mStroke then mStroke.Color = mode.stroke end
    end
    if switchBtn then
        switchBtn.BackgroundColor3 = mode.accentDim
        switchBtn.TextColor3 = mode.accent
        local sStroke = switchBtn:FindFirstChild("SwitchStroke")
        if sStroke then sStroke.Color = mode.stroke end
    end
    updateGuiStatus()
end

local function fetchServers()
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
        game.PlaceId
    )
    local ok, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if ok and result and result.data then return result.data end
    return {}
end

local function queueNextExecution()
    if not queueteleport_func then return false end
    markAuto()
    local codeToRun = "wait(2) pcall(function() loadstring(game:HttpGet('" .. SCRIPT_URL .. "'))() end)"
    local success = pcall(function()
        queueteleport_func(codeToRun)
    end)
    return success
end

TeleportService.TeleportInitFailed:Connect(function(player, result, errMsg)
    if player == LocalPlayer then
        lastTeleportError = tostring(errMsg)
        setStatus("ERRO: " .. tostring(errMsg), Color3.fromRGB(200, 110, 90))
    end
end)

local function hopToEventServer()
    if isHopping or not autoHopEnabled then return end
    if findEvent() then return end
    queueNextExecution()
    saveMode()
    isHopping = true
    updateGuiStatus()
    setStatus("Carregando lista...", Color3.fromRGB(180, 180, 130))
    local servers = fetchServers()
    local available = {}
    for _, s in ipairs(servers) do
        if s.playing < s.maxPlayers and s.id ~= game.JobId then
            table.insert(available, s)
        end
    end
    if #available == 0 then
        setStatus("Sem servidores", Color3.fromRGB(200, 100, 100))
        isHopping = false
        updateGuiStatus()
        task.wait(3)
        return
    end
    for i = #available, 2, -1 do
        local j = math.random(i)
        available[i], available[j] = available[j], available[i]
    end
    local total = math.min(#available, MAX_ATTEMPTS)
    setStatus("Iniciando: 0/" .. total, Color3.fromRGB(180, 180, 130))
    for i = 1, total do
        if not autoHopEnabled then break end
        if findEvent() then break end
        local s = available[i]
        setStatus("Tentando: " .. i .. "/" .. total, Color3.fromRGB(180, 180, 130))
        lastTeleportError = nil
        local ok = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
        end)
        if ok then
            local waited = 0
            local teleported = false
            while waited < TELEPORT_WAIT do
                task.wait(0.2)
                waited = waited + 0.2
                if game.JobId ~= startJobId then
                    teleported = true
                    break
                end
                if lastTeleportError then break end
            end
            if teleported then
                setStatus("Conectando...", Color3.fromRGB(150, 200, 150))
                break
            elseif lastTeleportError then
                setStatus("Ocupado", Color3.fromRGB(200, 130, 90))
                task.wait(RETRY_DELAY)
            else
                setStatus("Timeout", Color3.fromRGB(200, 150, 90))
                task.wait(RETRY_DELAY)
            end
        else
            setStatus("Falha", Color3.fromRGB(200, 100, 100))
            task.wait(RETRY_DELAY)
        end
    end
    setStatus("Reiniciando...", Color3.fromRGB(130, 130, 135))
    isHopping = false
    updateGuiStatus()
end

local function mainLoop()
    local lastHadEvent = false
    while true do
        task.wait(CHECK_INTERVAL)
        local hasEvent = findEvent() ~= nil
        if hasEvent ~= lastHadEvent then
            lastHadEvent = hasEvent
            updateGuiStatus()
            if hasEvent then
                setStatus(MODES[currentModeIndex].name .. " detectado", FOUND_COLOR)
            end
        end
        if autoHopEnabled and not hasEvent and not isHopping then
            task.spawn(hopToEventServer)
        end
    end
end

local function makeDraggable(frame, handle)
    local dragging, dragStart, startPos = false, nil, nil
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

