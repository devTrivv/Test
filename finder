local function findEvent()
    return Workspace:FindFirstChild(getCurrentEventName())
end

local function setStatus(text, color)
    if not statusLabel then return end
    statusLabel.Text = text
    statusLabel.TextColor3 = color or Color3.fromRGB(150, 150, 155)
end

local function updateGuiStatus()
    if not currentGui then return end
    local b = currentGui:FindFirstChild("FinderButton", true)
    if not b then return end
    local mode = MODES[currentModeIndex]
    
    if not autoHopEnabled then
        b.Text, b.TextColor3, b.BackgroundColor3 = "SEARCH", Color3.fromRGB(180, 90, 90), Color3.fromRGB(35, 18, 18)
        if btnStrokeRef then btnStrokeRef.Color = mode.stroke end
    elseif findEvent() then
        b.Text, b.TextColor3, b.BackgroundColor3 = "FOUND!", FOUND_COLOR, FOUND_BG
        if btnStrokeRef then btnStrokeRef.Color = FOUND_COLOR end
    elseif isHopping then
        b.Text, b.TextColor3, b.BackgroundColor3 = "SEARCHING", mode.accent, mode.btnBg
        if btnStrokeRef then btnStrokeRef.Color = mode.stroke end
    else
        b.Text, b.TextColor3, b.BackgroundColor3 = "SEARCH", mode.accent, mode.btnBg
        if btnStrokeRef then btnStrokeRef.Color = mode.stroke end
    end
end

local function applyModeColors()
