--=== HOP ===--
local function hopToEventServer()
    if isHopping or not autoHopEnabled then return end
    if findEvent() then return end
    
    -- Enfileira o script pro próximo servidor
    queueNextExecution()
    saveMode()
    
    isHopping = true
    updateGuiStatus()
    setStatus("Carregando lista...", Color3.fromRGB(180, 180, 130))
    
    local servers = fetchServers()
    local available = {}
    for _, s in ipairs(servers) do
        if s.playing < s.maxPlayers and s.id ~= game.JobId then
            table.insert(available, s)
        end
    end
    
    if #available == 0 then
        setStatus("Sem servidores disponiveis", Color3.fromRGB(200, 100, 100))
        isHopping = false
        updateGuiStatus()
        task.wait(3)
        return
    end
    
    for i = #available, 2, -1 do
        local j = math.random(i)
        available[i], available[j] = available[j], available[i]
    end
    
    local total = math.min(#available, MAX_ATTEMPTS)
    setStatus("Iniciando: 0/" .. total, Color3.fromRGB(180, 180, 130))
    
    for i = 1, total do
        if not autoHopEnabled then break end
        if findEvent() then break end
        
        local s = available[i]
        setStatus("Tentando: " .. i .. "/" .. total, Color3.fromRGB(180, 180, 130))
        
        lastTeleportError = nil
        
        local ok = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
        end)
        
        if ok then
            local waited = 0
            local teleported = false
            while waited < TELEPORT_WAIT do
                task.wait(0.2)
                waited = waited + 0.2
                if game.JobId ~= startJobId then
                    teleported = true
                    break
                end
                if lastTeleportError then break end
            end
            
            if teleported then
                setStatus("Conectando...", Color3.fromRGB(150, 200, 150))
                break
            elseif lastTeleportError then
                setStatus("Ocupado: " .. lastTeleportError, Color3.fromRGB(200, 130, 90))
                task.wait(RETRY_DELAY)
            else
                setStatus("Timeout, proximo...", Color3.fromRGB(200, 150, 90))
                task.wait(RETRY_DELAY)
            end
        else
            setStatus("Falha na conexao", Color3.fromRGB(200, 100, 100))
            task.wait(RETRY_DELAY)
        end
    end
    
    setStatus("Reiniciando...", Color3.fromRGB(130, 130, 135))
    isHopping = false
    updateGuiStatus()
end

--=== LOOP ===--
local function mainLoop()
    local lastHadEvent = false
    while true do
        task.wait(CHECK_INTERVAL)
        local hasEvent = findEvent() ~= nil
        if hasEvent ~= lastHadEvent then
            lastHadEvent = hasEvent
            updateGuiStatus()
            if hasEvent then
                setStatus(MODES[currentModeIndex].name .. " detectado", FOUND_COLOR)
            end
        end
        if autoHopEnabled and not hasEvent and not isHopping then
            task.spawn(hopToEventServer)
        end
    end
end

--=== DRAG ===--
local function makeDraggable(frame, handle)
    local dragging, dragStart, startPos = false, nil, nil
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

