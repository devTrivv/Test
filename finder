--=== FETCH SERVIDORES ===--
local function fetchServers()
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
        game.PlaceId
    )
    local ok, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if ok and result and result.data then return result.data end
    return {}
end

--=== QUEUE ON TELEPORT ===--
-- Enfileira o script pra rodar automaticamente no próximo servidor
local function queueNextExecution()
    if not queueteleport_func then return false end
    
    -- Marca que vamos hopar (o script do próximo servidor vai ver isso)
    markAuto()
    
    -- Monta o código que vai rodar no próximo servidor
    -- Ele baixa o script do GitHub e executa
    local codeToRun = string.format([[
        wait(2)
        local ok, err = pcall(function()
            loadstring(game:HttpGet("%s"))()
        end)
        if not ok then
            warn("[FINDER] Erro ao carregar: " .. tostring(err))
        end
    ]], SCRIPT_URL)
    
    local success = pcall(function()
        queueteleport_func(codeToRun)
    end)
    
    return success
end

