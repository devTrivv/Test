local TweenService = game:GetService("TweenService")
local rootPart = game.Players.LocalPlayer.Character:WaitForChild("HumanoidRootPart")

-- ======================================================================
-- CONFIGURAÇÃO DOS DESTINOS (Modifique aqui)
-- ======================================================================

-- Se você NÃO quiser um segundo destino, mude a linha abaixo para: local segundoDestino = nil
local segundoDestino = nil 

-- Configuração do Tween (VELOCIDADE MÁXIMA)
local info = TweenInfo.new(0.05, Enum.EasingStyle.Linear) -- Reduzido para 0.05 segundos

-- ======================================================================
-- CONFIGURAÇÃO DAS ÁREAS DE RENDERIZAÇÃO (Modifique aqui)
-- ======================================================================
local zonaInicial = 40  -- Primeira zona para renderizar
local zonaFinal = 46    -- Última zona para renderizar

-- ======================================================================
-- [ MODIFICADO ] DETECÇÃO DO INVENTÁRIO CHEIO E TELEPORTE (SEM VENDA)
-- ======================================================================
local TeleportService = game:GetService("ReplicatedStorage").Packages._Index["acecateer_knit@1.7.2"].knit.Services.BaseTeleportService.RF.TeleportToSpawn

local podePegar = true
local precisaRenderizar = true  -- Começa true para renderizar na primeira vez

-- Função para verificar se o inventário está cheio (funciona com qualquer número)
local function verificarInventario()
    local success, resultado = pcall(function()
        local backpack = game:GetService("Players").LocalPlayer.PlayerGui.MainScreenGui.Currencies.Backpack.Value
        if backpack and backpack:IsA("TextLabel") then
            local texto = backpack.ContentText
            if texto then
                local partes = {}
                for parte in string.gmatch(texto, "([^/]+)") do
                    table.insert(partes, parte)
                end
                if #partes == 2 then
                    local atual = tonumber(partes[1]) or 0
                    local maximo = tonumber(partes[2]) or 0
                    if atual >= maximo and maximo > 0 then
                        return true
                    end
                end
            end
        end
        return false
    end)
    
    if success then
        return resultado
    else
        return false
    end
end

-- Loop de verificação contínua (executa em paralelo)
coroutine.wrap(function()
    while true do
        local success, erro = pcall(function()
            if verificarInventario() and podePegar then
                print("[DETECTADO] Inventário cheio! Teleportando para o spawn...")
                podePegar = false
                
                local Result = table.pack(TeleportService:InvokeServer())
                print("[TELEPORT] Teleportado para o spawn!")
                
                task.wait() -- Apenas 1 frame de espera
                
                podePegar = true
                precisaRenderizar = true  -- ATIVA A RENDERIZAÇÃO NOVAMENTE!
                print("[LIBERADO] Volta a pegar Divine! Vai renderizar novamente!")
            end
        end)
        
        if not success then
            print("[ERRO] Falha no loop de inventário:", erro)
            podePegar = true
        end
        
        task.wait() -- Verificação mais rápida (a cada frame)
    end
end)()
-- ======================================================================

-- ======================================================================
-- FUNÇÃO PARA RENDERIZAR ÁREAS USANDO Zone_Particles
-- ======================================================================
local function renderizarAreas()
    print("[RENDERIZAÇÃO] Iniciando renderização das áreas " .. zonaInicial .. " até " .. zonaFinal .. "...")
    
    for zoneNumber = zonaInicial, zonaFinal do
        local zoneName = "Zone_" .. zoneNumber
        
        -- Tenta encontrar a Zone_Particles (nome fixo, sem número)
        local zoneParticles = nil
        
        local success, result = pcall(function()
            local zone = workspace.Zones.W4[zoneName]
            if zone then
                -- Procura por Zone_Particles (nome fixo)
                return zone:FindFirstChild("Zone_Particles")
            end
            return nil
        end)
        
        if success and result then
            zoneParticles = result
        end
        
        if zoneParticles then
            print("[RENDERIZAÇÃO] Indo para Zone_Particles da " .. zoneName .. "...")
            
            local successTween, erroTween = pcall(function()
                rootPart.Anchored = true
                
                local animacao = TweenService:Create(rootPart, info, {CFrame = zoneParticles.CFrame})
                animacao:Play()
                
                animacao.Completed:Wait()
                rootPart.Anchored = false
            end)
            
            if not successTween then
                print("[ERRO] Falha ao mover para Zone_Particles da " .. zoneName .. ":", erroTween)
                pcall(function()
                    rootPart.Anchored = false
                end)
            end
            
            -- task.wait() removido para máxima velocidade
        else
            print("[RENDERIZAÇÃO] Zone_Particles da " .. zoneName .. " não encontrada, pulando...")
        end
    end
    
    print("[RENDERIZAÇÃO] Todas as áreas processadas!")
    precisaRenderizar = false  -- Desativa a renderização até o próximo teleporte
end

-- ======================================================================
-- LOOP PRINCIPAL (OTIMIZADO - VELOCIDADE MÁXIMA)
-- ======================================================================
while true do
    -- Se precisa renderizar, renderiza
    if precisaRenderizar then
        local successRender, erroRender = pcall(function()
            renderizarAreas()
        end)
        
        if not successRender then
            print("[ERRO] Falha na renderização:", erroRender)
            pcall(function()
                rootPart.Anchored = false
            end)
        end
    end
    
    -- Pega Genesis continuamente
    for zoneNumber = zonaInicial, zonaFinal do
        if not podePegar then break end
        
        local zoneName = "Zone_" .. zoneNumber
        
        local success, spawnZone = pcall(function()
            return workspace.Zones.W4[zoneName].SpawnZone
        end)
        
        if success and spawnZone then
            for i, v in pairs(spawnZone:GetChildren()) do
                if not podePegar then break end
                
                if v:IsA("Model") and v:GetAttribute("LootRarity") == "Singularity" then
                    
                    local successItem, erro = pcall(function()
                        local primeiroDestino = v

                        -- Vai até o Genesis (direto, sem espera)
                        rootPart.Anchored = true 

                        local animacao1 = TweenService:Create(rootPart, info, {CFrame = primeiroDestino:GetPivot()})
                        animacao1:Play()

                        animacao1.Completed:Wait()
                        rootPart.Anchored = false 
                        print("Cheguei no destino: " .. primeiroDestino.Name)
                        
                        -- Prompt (MANTIDO INTACTO - não mexer aqui!)
                        local p = nil
                        for _, filho in pairs(primeiroDestino:GetDescendants()) do
                            if filho:IsA("ProximityPrompt") then
                                p = filho
                                break
                            end
                        end

                        if p then 
                            fireproximityprompt(p, 0)
                            print("Prompt feito no bloco usando comando direto!")
                            task.wait()  -- MANTIDO INTACTO!
                        else
                            print("Nenhum ProximityPrompt encontrado em: " .. primeiroDestino.Name)
                        end

                        -- Segundo destino
                        if segundoDestino ~= nil then
                            print("Segundo destino detectado! Iniciando delay de espera...")
                            
                            task.wait(3)
                            
                            print("Indo para o segundo destino (Lobby)...")
                            rootPart.Anchored = true 
                            
                            local animacao2 = TweenService:Create(rootPart, info, {CFrame = segundoDestino:GetPivot()})
                            animacao2:Play()
                            
                            animacao2.Completed:Wait()
                            rootPart.Anchored = false 
                            print("Cheguei no segundo destino final!")
                        else
                            print("Nenhum segundo destino foi colocado para este item.")
                        end
                        
                        task.wait()
                    end)
                    
                    if not successItem then
                        print("[ERRO] Falha ao processar item:", erro)
                        pcall(function()
                            rootPart.Anchored = false
                        end)
                    end
                end
            end
        end
    end
    
    task.wait()  -- Yield mínimo (1 frame)
end
