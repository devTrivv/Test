local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

-- ======================================================================
-- CONFIGURAÇÃO DOS DESTINOS (Modifique aqui)
-- ======================================================================
local segundoDestino = nil 

-- Tween MUITO rápido (0.05 segundos)
local info = TweenInfo.new(0.05, Enum.EasingStyle.Linear)

-- ======================================================================
-- SERVIÇOS
-- ======================================================================
local TeleportService = game:GetService("ReplicatedStorage").Packages._Index["acecateer_knit@1.7.2"].knit.Services.BaseTeleportService.RF.TeleportToSpawn
local SellService = game:GetService("ReplicatedStorage").Packages._Index["acecateer_knit@1.7.2"].knit.Services.DataService.RF.SellAllBackpackLoot

local podePegar = true
local isTeleporting = false

-- ======================================================================
-- FUNÇÃO PARA VERIFICAR INVENTÁRIO (COM PROTEÇÃO TOTAL)
-- ======================================================================
local function verificarInventario()
    local success, resultado = pcall(function()
        local backpack = player.PlayerGui.MainScreenGui.Currencies.Backpack
        
        if not backpack then return false end
        
        local texto = backpack.ContentText
        if not texto then return false end
        
        local atual, maximo = texto:match("(%d+)/(%d+)")
        
        if atual and maximo then
            atual = tonumber(atual)
            maximo = tonumber(maximo)
            
            if atual and maximo and maximo > 0 and atual >= maximo then
                return true
            end
        end
        
        return false
    end)
    
    if success then
        return resultado
    else
        return false
    end
end

-- ======================================================================
-- FUNÇÃO PARA TELEPORTAR E VENDER (COM PROTEÇÃO TOTAL)
-- ======================================================================
local function teleportarEVender()
    if isTeleporting then return end
    isTeleporting = true
    
    print("[DETECTADO] Inventário cheio! Teleportando...")
    podePegar = false
    
    -- Teleporte com proteção total
    local success, erro = pcall(function()
        TeleportService:InvokeServer()
    end)
    
    if not success then
        print("[ERRO] Falha no teleporte:", erro)
    else
        print("[SUCESSO] Teleportado!")
    end
    
    task.wait(0.2)
    
    -- Venda com proteção total
    success, erro = pcall(function()
        SellService:InvokeServer()
    end)
    
    if not success then
        print("[ERRO] Falha na venda:", erro)
    else
        print("[SUCESSO] Vendido!")
    end
    
    task.wait(0.2)
    
    podePegar = true
    isTeleporting = false
    print("[LIBERADO] Voltou a pegar!")
end

-- ======================================================================
-- LOOP DE VERIFICAÇÃO DE INVENTÁRIO (PROTEGIDO)
-- ======================================================================
coroutine.wrap(function()
    while true do
        local success, erro = pcall(function()
            if verificarInventario() and podePegar and not isTeleporting then
                teleportarEVender()
            end
        end)
        
        if not success then
            print("[ERRO NO LOOP DE INVENTÁRIO]:", erro)
        end
        
        task.wait(0.3)
    end
end)()

-- ======================================================================
-- FUNÇÃO PARA MOVER COM TWEEN RÁPIDO (PROTEGIDA)
-- ======================================================================
local function moverParaDestino(destino)
    local success, erro = pcall(function()
        if not destino or not rootPart then return false end
        
        rootPart.Anchored = true
        
        local tween = TweenService:Create(rootPart, info, {CFrame = destino:GetPivot()})
        tween:Play()
        
        tween.Completed:Wait()
        rootPart.Anchored = false
        
        return true
    end)
    
    if not success then
        print("[ERRO NO MOVIMENTO]:", erro)
        -- Tenta liberar o personagem caso tenha ficado travado
        pcall(function()
            if rootPart then
                rootPart.Anchored = false
            end
        end)
        return false
    end
    
    return resultado
end

-- ======================================================================
-- LOOP PRINCIPAL (PROTEÇÃO TOTAL - NUNCA PARA)
-- ======================================================================
while true do
    -- Proteção total do loop inteiro
    local success, erro = pcall(function()
        -- Verifica se o personagem ainda existe
        if not character or not character.Parent then
            character = player.Character or player.CharacterAdded:Wait()
            rootPart = character:WaitForChild("HumanoidRootPart")
        end
        
        for zoneNumber = 47, 57 do
            if not podePegar then break end
            
            local zoneName = "Zone_" .. zoneNumber
            
            -- Acesso à zona com proteção
            local successZone, zone = pcall(function()
                return workspace.Zones.W5[zoneName]
            end)
            
            if not successZone or not zone then continue end
            
            local spawnZone = zone:FindFirstChild("SpawnZone")
            
            if not spawnZone then continue end
            
            -- Varre todos os filhos
            for _, v in pairs(spawnZone:GetChildren()) do
                if not podePegar then break end
                
                -- Verificação do item com proteção
                local successItem, isGenesis = pcall(function()
                    return v:IsA("Model") and v:GetAttribute("LootRarity") == "Genesis"
                end)
                
                if successItem and isGenesis then
                    
                    print("Indo para: " .. v.Name)
                    
                    -- Move com Tween rápido (já tem proteção interna)
                    moverParaDestino(v)
                    
                    task.wait(0.5)
                    
                    -- PROMPT ORIGINAL (COM PROTEÇÃO)
                    local successPrompt, erroPrompt = pcall(function()
                        local p = nil
                        for _, filho in pairs(v:GetDescendants()) do
                            if filho:IsA("ProximityPrompt") then
                                p = filho
                                break
                            end
                        end

                        if p then 
                            fireproximityprompt(p, 0)
                            print("Prompt feito no bloco usando comando direto!")
                            task.wait(0.5)
                        else
                            print("Nenhum ProximityPrompt encontrado em: " .. v.Name)
                        end
                    end)
                    
                    if not successPrompt then
                        print("[ERRO NO PROMPT]:", erroPrompt)
                    end

                    -- Segundo destino (se existir)
                    if segundoDestino ~= nil then
                        print("Indo para segundo destino...")
                        
                        task.wait(3)
                        
                        moverParaDestino(segundoDestino)
                    end
                    
                    task.wait(0.5)
                end
            end
        end
    end)
    
    -- Se der qualquer erro, o script NÃO para
    if not success then
        print("[ERRO NO LOOP PRINCIPAL]:", erro)
        print("[RECUPERANDO] Continuando execução...")
        
        -- Garante que o personagem não fique preso
        pcall(function()
            if rootPart then
                rootPart.Anchored = false
            end
        end)
        
        -- Garante que podePegar volte a true
        podePegar = true
        isTeleporting = false
    end
    
    task.wait(0.1)
end
