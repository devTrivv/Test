local TweenService = game:GetService("TweenService")
local rootPart = game.Players.LocalPlayer.Character:WaitForChild("HumanoidRootPart")

-- ======================================================================
-- CONFIGURAÇÃO DOS DESTINOS (Modifique aqui)
-- ======================================================================

-- Se você NÃO quiser um segundo destino, mude a linha abaixo para: local segundoDestino = nil
local segundoDestino = nil 

-- Configuração do Tween (2 segundos de viagem)
local info = TweenInfo.new(0.2, Enum.EasingStyle.Linear)

-- ======================================================================
-- [ ADIÇÃO ] DETECÇÃO DO INVENTÁRIO CHEIO E TELEPORTE
-- ======================================================================
local TeleportService = game:GetService("ReplicatedStorage").Packages._Index["acecateer_knit@1.7.2"].knit.Services.BaseTeleportService.RF.TeleportToSpawn
local SellService = game:GetService("ReplicatedStorage").Packages._Index["acecateer_knit@1.7.2"].knit.Services.DataService.RF.SellAllBackpackLoot

local podePegar = true

-- Função para verificar se o inventário está cheio (funciona com qualquer número)
local function verificarInventario()
    local backpack = game:GetService("Players").LocalPlayer.PlayerGui.MainScreenGui.Currencies.Backpack.Value
    if backpack and backpack:IsA("TextLabel") then
        local texto = backpack.ContentText
        if texto then
            local partes = {}
            for parte in string.gmatch(texto, "([^/]+)") do
                table.insert(partes, parte)
            end
            if #partes == 2 then
                local atual = tonumber(partes[1]) or 0
                local maximo = tonumber(partes[2]) or 0
                if atual >= maximo and maximo > 0 then
                    return true
                end
            end
        end
    end
    return false
end

-- Loop de verificação contínua (executa em paralelo)
coroutine.wrap(function()
    while true do
        if verificarInventario() and podePegar then
            print("[DETECTADO] Inventário cheio! Teleportando para o spawn...")
            podePegar = false
            
            local Result = table.pack(TeleportService:InvokeServer())
            print("[TELEPORT] Teleportado para o spawn!")
            
            task.wait(0.5)
            
            print("[VENDA] Vendendo todo o inventário...")
            SellService:InvokeServer()
            print("[VENDA] Inventário vendido com sucesso!")
            task.wait(0.5)
            
            podePegar = true
            print("[LIBERADO] Volta a pegar Divine!")
        end
        task.wait(1)
    end
end)()
-- ======================================================================

-- ======================================================================
-- LOOP: Varre TODAS as Zones de 14 a 23 (COM VERIFICAÇÃO DE CARREGAMENTO)
-- ======================================================================
while true do
  
  for zoneNumber = 47, 57 do
    local zoneName = "Zone_" .. zoneNumber
    
    -- ======================================================================
    -- VERIFICA SE O SPAWNZONE EXISTE (ESPERA CARREGAR SE NÃO EXISTIR)
    -- ======================================================================
    local spawnZone = nil
    local tentativas = 0
    local maxTentativas = 10  -- Tenta por até 10 segundos
    
    while tentativas < maxTentativas do
        -- Tenta acessar o SpawnZone com proteção
        local success, result = pcall(function()
            return workspace.Zones.W5[zoneName].SpawnZone
        end)
        
        if success and result then
            spawnZone = result
            break  -- Encontrou! Sai do loop
        end
        
        tentativas = tentativas + 1
        task.wait(1)  -- Espera 1 segundo e tenta novamente
    end
    
    -- Se encontrou o SpawnZone, processa
    if spawnZone then
        print("Varrendo: " .. zoneName .. " (carregado!)")
        
        for i, v in pairs(spawnZone:GetChildren()) do
            if podePegar and v:IsA("Model") and v:GetAttribute("LootRarity") == "Genesis" then
                
                local primeiroDestino = v

                -- ======================================================================
                -- VIAGEM 1: Vai até o Slime Divino atual
                -- ======================================================================
                rootPart.Anchored = true 

                local animacao1 = TweenService:Create(rootPart, info, {CFrame = primeiroDestino:GetPivot()})
                animacao1:Play()

                animacao1.Completed:Wait()
                rootPart.Anchored = false 
                print("Cheguei no destino: " .. primeiroDestino.Name)
                wait(0.5)
                
                -- ======================================================================
                -- PROMPT AUTOMÁTICO
                -- ======================================================================
                local p = nil
                for _, filho in pairs(primeiroDestino:GetDescendants()) do
                    if filho:IsA("ProximityPrompt") then
                        p = filho
                        break
                    end
                end

                if p then 
                    fireproximityprompt(p, 0)
                    print("Prompt feito no bloco usando comando direto!")
                    task.wait(0.5)
                else
                    print("Nenhum ProximityPrompt encontrado em: " .. primeiroDestino.Name)
                end

                -- ======================================================================
                -- CHECAGEM DO SEGUNDO DESTINO
                -- ======================================================================
                if segundoDestino ~= nil then
                    print("Segundo destino detectado! Iniciando delay de espera...")
                    
                    task.wait(3)
                    
                    print("Indo para o segundo destino (Lobby)...")
                    rootPart.Anchored = true 
                    
                    local animacao2 = TweenService:Create(rootPart, info, {CFrame = segundoDestino:GetPivot()})
                    animacao2:Play()
                    
                    animacao2.Completed:Wait()
                    rootPart.Anchored = false 
                    print("Cheguei no segundo destino final!")
                else
                    print("Nenhum segundo destino foi colocado para este item.")
                end
                
                task.wait() 
                
            end
        end
    else
        print("Zone " .. zoneName .. " não carregou após " .. maxTentativas .. " segundos, ignorando...")
    end
  end
  
  task.wait(0.5)
end
