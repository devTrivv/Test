local TweenService = game:GetService("TweenService")
local rootPart = game.Players.LocalPlayer.Character:WaitForChild("HumanoidRootPart")

local segundoDestino = workspace.FloorPart

local info = TweenInfo.new(1, Enum.EasingStyle.Linear)

while true do
  for _, area in pairs(workspace.ItemSpawns:GetChildren()) do
    for i, v in pairs(area:GetChildren()) do 
      if v.Name == "SpawnedItem" and v:GetAttribute("Rarity") == "Secret" then
        local primeiroDestino = v

        rootPart.Anchored = true 

        local animacao1 = TweenService:Create(rootPart, info, {CFrame = primeiroDestino:GetPivot()})
        animacao1:Play()

        animacao1.Completed:Wait() 
        rootPart.Anchored = false 
        print("Arrived at destination: " .. primeiroDestino.Name)
        wait(0.5)

        local p = nil
        for _, filho in pairs(primeiroDestino:GetDescendants()) do
            if string.find(string.lower(filho.Name), "prompt") then
                p = filho
                break
            end
        end

        if p then 
            fireproximityprompt(p, 0) 
            print("Prompt executed on block using direct command!")
            task.wait(0.5)
        end

        if segundoDestino ~= nil then
            print("Second destination detected! Starting wait delay...")
            
            task.wait(0.5) 
            
            print("Going to the second destination (Lobby)...")
            rootPart.Anchored = true 
            
            local animacao2 = TweenService:Create(rootPart, info, {CFrame = segundoDestino:GetPivot()})
            animacao2:Play()
            
            animacao2.Completed:Wait() 
            rootPart.Anchored = false 
            print("Arrived at the final second destination!")
        else
            print("No second destination was set for this item.")
        end
        
        task.wait(0.5) 
      end
    end
  end
    task.wait(0.5)
end
